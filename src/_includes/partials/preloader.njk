{#- Covers the page until the fonts and the first hero photo are ready (script.js removes it).
    It animates by itself (CSS + SVG), so it moves even before the script has loaded. -#}
<div class="preloader" data-preloader role="status">
  <span class="sr-only">{{ i18n.loading | t(lang) }}</span>
  <div class="pl-inner" aria-hidden="true">
    <div class="pl-stage">
      <svg class="pl-trail" viewBox="0 0 260 96" width="260" height="96">
        <path class="pl-base" pathLength="1" d="M14 76C54 76 58 30 98 34S140 78 176 60 214 18 246 22"/>
        <path class="pl-draw" pathLength="1" d="M14 76C54 76 58 30 98 34S140 78 176 60 214 18 246 22"/>
        <circle class="pl-start" cx="14" cy="76" r="6"/>
        <path class="pl-flag" d="M246 22V2l14 6-14 6"/>
      </svg>
      <span class="pl-walker"></span>
    </div>
    <p class="pl-text">{{ i18n.preloader | t(lang) }}</p>
  </div>
</div>
