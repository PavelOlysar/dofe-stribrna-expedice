<div class="lightbox" id="lightbox" hidden role="dialog" aria-modal="true" aria-label="{{ i18n.lightboxLabel | t(lang) }}">
  <img class="lb-img" id="lb-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="">
  <button type="button" class="round-btn lb-btn lb-close" data-lb-close aria-label="{{ i18n.close | t(lang) }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
  <button type="button" class="round-btn lb-btn lb-prev" data-lb-prev aria-label="{{ i18n.prevPhoto | t(lang) }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></button>
  <button type="button" class="round-btn lb-btn lb-next" data-lb-next aria-label="{{ i18n.nextPhoto | t(lang) }}"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></button>
  <div class="lb-count" id="lb-count" aria-live="polite"></div>
</div>
