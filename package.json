{
  "name": "dofe-stribrna-expedice",
  "private": true,
  "description": "Bilingual story page of our Silver DOFE expedition, built with Eleventy.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "eleventy --serve",
    "watch": "eleventy --watch",
    "build": "eleventy",
    "test": "html-validate \"_site/**/*.html\" && playwright test",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.0.0",
    "@playwright/test": "^1.63.0",
    "html-validate": "^10.9.0",
    "sharp": "^0.35.5"
  }
}
